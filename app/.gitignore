# dependencies
node_modules

# Nitro / TanStack Start
.nitro
.output
.vinxi
.tanstack
dist-ssr

# misc
.DS_Store

# env
.env
.env.*
!.env.example
.envrc

# Logs
logs
*.log

# Runtime
pids
*.pid
*.seed
*.pid.lock

# DB (Prisma)
*.sqlite
*.sqlite-journal
src/prisma/generated

# Local stats CSV exports (`bun run stats:export-csv`)
scripts/stats-export/*.csv

# Per-region share pages (`bun run bike-share-map:share-pages`) – one stub + OG image per
# Gemeinde/Landkreis/Bundesland (~10k+ files), regenerated by CI on every viewer deploy.
scripts/bike-share-map/output/viewer/r/
# Per-region CSV download (dataDownload.ts), ~4 MB, regenerated by CI on every viewer deploy.
scripts/bike-share-map/output/viewer/daten/
# A local npm install (e.g. Playwright for screenshots) must not be published with the viewer.
scripts/bike-share-map/output/viewer/package*.json

# Testing
.coverage
*.lcov
.nyc_output
playwright-report*
test-results/

# Caches
*.tsbuildinfo
.eslintcache
.node_repl_history

# Bike routing to the nearest station (scripts/bike-share-map/routing/README.md) – Python env,
# OSM extract, parsed network and per-square results stay local.
scripts/bike-share-map/routing/.venv/
scripts/bike-share-map/routing/cache/
scripts/bike-share-map/cache/
# Optional full GeoJSON export (`export-stats-geojson -- --geojson`, 49 MB) for local analysis;
# the build reads stats.msgpack.
scripts/bike-share-map/output/stats.geojson
# Copied from scripts/bike-share-map/vendor/ by every build.
scripts/bike-share-map/output/viewer/vendor/
scripts/bike-share-map/routing/__pycache__/
